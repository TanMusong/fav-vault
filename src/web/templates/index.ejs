          metaEl.insertBefore(span, metaEl.firstChild.nextSibling);
        }
        var headerEl = postEl.querySelector('.post-header');
        var barHtml = '<div class="post-progress-bar"><div class="post-progress-fill" id="progress-bar-' + postIdx + '" style="width:' + p + '%"></div></div>';
        headerEl.insertAdjacentHTML('afterend', barHtml);
      }
      files.forEach(function(f, fi) {
        var fileEl = document.getElementById('file-' + postIdx + '-' + fi);
        if (!fileEl) return;
        var fcls = safeClass(f.fileStatus === 'failed' ? 'failed' : f.fileStatus === 'downloading' ? 'downloading' : f.type);
        var metaDiv = fileEl.querySelector('.file-meta');
        var nameSpan = fileEl.querySelector('.file-name');
        if (f.fileStatus === 'downloading' && f.fileExpectedSize > 0) {
          var pct = Math.round(f.fileSize / f.fileExpectedSize * 100);
          var progressTextEl = metaDiv.querySelector('.file-progress-text');
          if (progressTextEl) progressTextEl.textContent = pct + '%';
          else {
            var newSpan = document.createElement('span');
            newSpan.className = 'file-progress-text';
            newSpan.textContent = pct + '%';
            metaDiv.insertBefore(newSpan, metaDiv.firstChild);
          }
          var fpb = metaDiv.querySelector('.file-progress-bar');
          if (!fpb) {
            metaDiv.insertAdjacentHTML('afterbegin', '<div class="file-progress-bar"><div class="file-progress-fill" style="width:' + pct + '%"></div></div>');
          } else {
            fpb.querySelector('.file-progress-fill').style.width = pct + '%';
          }
          var sizeSpan = metaDiv.querySelector('span:not(.file-progress-text):not(.file-type)');
          if (sizeSpan && sizeSpan.textContent.indexOf('KB') === -1) {
            sizeSpan.textContent = formatFileSize(f.fileSize);
          }
        } else if (f.fileStatus === 'success') {
          var typeEl = metaDiv.querySelector('.file-type');
          if (typeEl) { typeEl.className = 'file-type type-' + safeClass(f.type); typeEl.textContent = f.type; }
          var fpb2 = metaDiv.querySelector('.file-progress-bar');
          if (fpb2) fpb2.remove();
          var fpt = metaDiv.querySelector('.file-progress-text');
          if (fpt) { fpt.textContent = formatFileSize(f.fileSize); fpt.className = ''; }
          var sizeSpan2 = metaDiv.querySelector('span:not(.file-type)');
          if (!sizeSpan2 && f.fileSize > 0) {
            var sizeEl = document.createElement('span');
            sizeEl.textContent = formatFileSize(f.fileSize);
            metaDiv.insertBefore(sizeEl, metaDiv.querySelector('.file-type'));
          }
          if (nameSpan && !nameSpan.getAttribute('onclick')) {
            var postId = detailDownloads[postIdx] ? detailDownloads[postIdx].post_id : '';
            nameSpan.setAttribute('onclick', 'event.stopPropagation();openPreview(\'' + jsString(postId) + '\',\'' + jsString(f.filename) + '\')');
            nameSpan.style.cursor = 'pointer';
            nameSpan.style.color = '#999';
            nameSpan.style.textDecoration = 'underline';
          }
        }
        var typeSpan = fileEl.querySelector('.file-type');
        if (typeSpan) { typeSpan.className = 'file-type type-' + fcls; typeSpan.textContent = f.fileStatus === 'failed' ? _t('status.failed') : f.fileStatus === 'downloading' ? _t('status.downloading') : f.type; }
      });
      if (g.state !== 3) {
        var progressBar2 = document.getElementById('progress-bar-' + postIdx);
