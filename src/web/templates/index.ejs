    async function loadLogs(reset) {
      if (logsLoading) return;
      if (reset) { logsOffset = 0; logsTotal = 0; document.getElementById('logs-list').innerHTML = ''; }
      logsLoading = true;
      try {
        var url = '/api/logs?limit=50&offset=' + logsOffset;
        if (logsFilter !== 'all') url += '&level=' + logsFilter;
        var res = await fetch(url);
        var data = await res.json();
        logsTotal = data.total;
        var list = document.getElementById('logs-list');
        var colors = { error: '#f44336', warn: '#ff9800', info: '#1d9bf0' };
        data.items.forEach(function(item) {
          var color = colors[item.level] || '#888';
          var row = document.createElement('div');
          row.style.cssText = 'padding:8px 16px;border-bottom:1px solid #1a1a1a;font-size:12px;font-family:monospace;display:flex;gap:12px;align-items:flex-start;';
          var localTime = item.time ? new Date(item.time + 'Z').toLocaleString() : item.time;
          row.innerHTML = '<span style="color:' + color + ';min-width:44px;flex-shrink:0;">[' + escapeHtml(item.level) + ']</span><span style="color:#666;min-width:140px;flex-shrink:0;">' + escapeHtml(localTime) + '</span><span style="color:#4db8ff;min-width:80px;flex-shrink:0;">' + escapeHtml(item.taskName) + '</span><span style="color:#ccc;word-break:break-all;">' + escapeHtml(item.message) + '</span>';
          list.appendChild(row);
        });
        logsOffset += data.items.length;
      } catch (e) {}
      logsLoading = false;
    }

    document.getElementById('logs-list').addEventListener('scroll', function() {
      var el = this;
      if (el.scrollTop + el.clientHeight >= el.scrollHeight - 100 && logsOffset < logsTotal) {
        loadLogs(false);
      }
      var topBtn = document.getElementById('logs-top-btn');
      if (topBtn) topBtn.style.display = el.scrollTop > 200 ? 'flex' : 'none';
    });

    document.getElementById('logs-top-btn').addEventListener('click', function() {
      var el = document.getElementById('logs-list');
      var start = el.scrollTop;
      var target = 0;
      var distance = start - target;
      var duration = Math.min(500, Math.abs(distance) * 0.5);
      var startTime = null;
      function step(ts) {
        if (!startTime) startTime = ts;
        var progress = Math.min((ts - startTime) / duration, 1);
        var ease = 1 - Math.pow(1 - progress, 3);
        el.scrollTop = start - distance * ease;
        if (progress < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    });

    window.addEventListener('popstate', function(e) {
      if (e.state && e.state.view === 'detail' && e.state.taskId) {
        currentTaskId = e.state.taskId;
        detailOffset = 0;
        switchView('detail');
        openDetail(e.state.taskId, true);
      } else if (e.state && e.state.view === 'about') {
        switchView('about');
      } else if (e.state && e.state.view === 'logs') {
        openLogs();
      } else {
        switchView('list');
        currentTaskId = null;
      }
    });

    function togglePost(i) {
      var files = document.getElementById('files-' + i);
      var arrow = document.getElementById('arrow-' + i);
      if (files) files.classList.toggle('open');
      if (arrow) arrow.classList.toggle('open');
    }

    async function loadMoreDownloads() {
      detailOffset += DETAIL_LIMIT;
      await loadDownloads();
    }

    async function runDetailTask() {
      if (!currentTaskId) return;
      var btn = document.querySelector('.detail-actions .btn-primary');
      btn.textContent = _t('status.executing');
      btn.disabled = true;
      await fetch('/api/tasks/' + currentTaskId + '/run', { method: 'POST' });
    }

    async function deleteDetailTask() {
      if (!currentTaskId) return;
      if (!await showConfirm(_t('msg.confirm_delete'))) return;
      var deletedId = currentTaskId;
      fetch('/api/tasks/' + deletedId, { method: 'DELETE' }).then(function() {
        TASKS = TASKS.filter(function(t) { return t.id !== deletedId; });
        backToList();
        refreshTaskList();
      });
    }

    async function clearDetailDownloads() {
      if (!currentTaskId) return;
      if (!await showConfirm(_t('msg.confirm_clear'))) return;
      await fetch('/api/tasks/' + currentTaskId + '/downloads', { method: 'DELETE' });
      detailDownloads = [];
      renderDownloadList(0);
    }

    function openEditModal() {
      if (!currentTaskId || !currentTaskData) return;
      var task = currentTaskData;
      var site = SITES.find(function(s) { return s.name === task.site; });
      document.getElementById('modal-title').textContent = _t('modal.edit_task');
      document.getElementById('f-interval').value = Math.floor(task.interval / 60);
      document.getElementById('f-cookie').value = '';
      document.getElementById('interval-hint').classList.remove('show');
      document.getElementById('f-interval').closest('.field').style.display = '';
      document.getElementById('f-cookie').closest('.field').style.display = '';
      document.getElementById('site-disabled-hint').style.display = 'none';
      setAdvancedConfig(task.customConfigJson || {});
      document.querySelector('.modal-footer .btn-primary').disabled = false;
      document.getElementById('modal-overlay').classList.add('active');
      selectSite(task.site);
      document.querySelectorAll('.site-option').forEach(function(el) {
        el.style.pointerEvents = 'none';
        el.style.opacity = '0.5';
      });
      var submitBtn = document.querySelector('.modal-footer .btn-primary');
      submitBtn.textContent = _t('modal.save');
      submitBtn.onclick = submitEdit;
    }

    async function submitEdit() {
      if (!currentTaskId) return;
      var interval = parseInt(document.getElementById('f-interval').value) || 30;
      if (interval < 10) return showMsg(_t('msg.interval_short'));
      var cookies = document.getElementById('f-cookie')?.value?.trim() || '';

      var btn = document.querySelector('.modal-footer .btn-primary');
      btn.textContent = _t('msg.saving');
      btn.disabled = true;

      var body = { interval: interval * 60, customConfigJson: getAdvancedConfig() };
      if (cookies) body.cookies = cookies;

      const res = await fetch('/api/tasks/' + currentTaskId, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      const data = await res.json();

      btn.textContent = _t('modal.save');
      btn.disabled = false;

      if (!res.ok) { showMsg(_t('msg.save_failed') + _t(data.error || 'msg.unknown_error')); return; }
      closeModal();
      currentTaskData = data;
      renderDetailMeta();
    }

    var previewFiles = [];
    var previewIndex = 0;

    function openPreview(postId, filename) {
      if (!currentTaskId) return;
      var dl = detailDownloads.find(function(d) { return d.post_id === postId; });
      previewFiles = dl ? dl.files.filter(function(f) { return f.fileStatus === 'success'; }) : [];
      previewIndex = Math.max(0, previewFiles.findIndex(function(f) { return f.filename === filename; }));
      document.getElementById('preview-overlay').classList.add('active');
      renderPreview();
    }

    function renderPreview() {
      if (previewIndex < 0 || previewIndex >= previewFiles.length) return;
      var f = previewFiles[previewIndex];
      var ext = f.filename.split('.').pop().toLowerCase();
      var url = '/api/tasks/' + currentTaskId + '/preview/' + detailDownloads.find(function(d) { return d.files.indexOf(f) >= 0; }).post_id + '/' + encodeURIComponent(f.filename);
      var container = document.getElementById('preview-content');
      if (['mp4', 'webm', 'ogg'].indexOf(ext) >= 0) {
        container.innerHTML = '<video src="' + escapeHtml(url) + '" controls autoplay style="max-width:90vw;max-height:90vh;border-radius:8px;"></video>';
      } else if (['jpg', 'jpeg', 'png', 'gif', 'webp'].indexOf(ext) >= 0) {
        container.innerHTML = '<img src="' + escapeHtml(url) + '" style="max-width:90vw;max-height:90vh;border-radius:8px;">';
      } else {
        container.innerHTML = '<div style="color:#888;font-size:14px;">' + escapeHtml(_t('msg.preview_unsupported')) + '</div>';
      }
      document.getElementById('preview-filename').textContent = f.filename + ' (' + (previewIndex + 1) + '/' + previewFiles.length + ')';
    }

    function previewPrev() {
      if (previewFiles.length <= 1) return;
      var video = document.querySelector('#preview-content video');
      if (video) video.pause();
      previewIndex = (previewIndex - 1 + previewFiles.length) % previewFiles.length;
      renderPreview();
    }

    function previewNext() {
      if (previewFiles.length <= 1) return;
      var video = document.querySelector('#preview-content video');
      if (video) video.pause();
      previewIndex = (previewIndex + 1) % previewFiles.length;
      renderPreview();
    }

    function closePreview() {
      var overlay = document.getElementById('preview-overlay');
      overlay.classList.remove('active');
      var video = overlay.querySelector('video');
      if (video) video.pause();
      document.getElementById('preview-content').innerHTML = '';
    }

    document.addEventListener('keydown', function(e) {
      if (!document.getElementById('preview-overlay').classList.contains('active')) return;
      if (e.key === 'ArrowLeft') { e.preventDefault(); previewPrev(); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); previewNext(); }
      else if (e.key === 'Escape') closePreview();
    });

    async function toggleDetailPause() {
      if (!currentTaskId) return;
      await fetch('/api/tasks/' + currentTaskId + '/pause', { method: 'POST' });
      currentTaskData.paused = !currentTaskData.paused;
      renderDetailMeta();
    }

    async function refreshDetailTask() {
      if (!currentTaskId) return;
      const taskRes = await fetch('/api/tasks/' + currentTaskId);
      const task = await taskRes.json();
      if (currentTaskData && currentTaskData.next_run && task.next_run && new Date(currentTaskData.next_run) > new Date(task.next_run)) {
        task.next_run = currentTaskData.next_run;
      }
      currentTaskData = task;
      renderDetailMeta();
    }

    function initDetailFromHash() {
      if (location.hash.startsWith('#detail-')) {
        openDetail(location.hash.replace('#detail-', ''), true);
      }
    }
    if (window._i18nReady) initDetailFromHash();
    else document.addEventListener('i18nready', initDetailFromHash);
  </script>
</body>
</html>
