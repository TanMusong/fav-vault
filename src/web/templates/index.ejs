    function renderFileItem(f, postIdx, fileIdx) {
      var fcls = safeClass(f.fileStatus === 'failed' ? 'failed' : f.fileStatus === 'downloading' ? 'downloading' : f.type);
      var postId = detailDownloads[postIdx] ? detailDownloads[postIdx].post_id : '';
      var clickable = f.fileStatus === 'success' ? ' onclick="event.stopPropagation();openPreview(\'' + jsString(postId) + '\',\'' + jsString(f.filename) + '\')\" style="cursor:pointer;color:#999;text-decoration:underline;"' : '';
      var html = '<div class="file-item" id="file-' + postIdx + '-' + fileIdx + '">';
