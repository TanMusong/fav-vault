    function formatFileSize(bytes) {
      if (bytes >= 1073741824) return (bytes / 1073741824).toFixed(2).replace(/\.?0+$/, '') + ' GB';
      if (bytes >= 1048576) return (bytes / 1048576).toFixed(2).replace(/\.?0+$/, '') + ' MB';
