<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fav Vault</title>
  <link rel="icon" href="/favicon.ico">
  <link rel="stylesheet" href="/font-awesome/css/all.min.css">
  <%- include('partials/css') %>
  <script>
    (function() {
      var lang = localStorage.getItem('lang') || (function() {
        var locales = ['zh-CN', 'zh-TW', 'en'];
        var nav = navigator.language;
        for (var i = 0; i < locales.length; i++) {
          if (nav.startsWith(locales[i].split('-')[0])) return locales[i];
        }
        return 'en';
      })();
      localStorage.setItem('lang', lang);
      document.documentElement.lang = lang;
      var s = document.createElement('script');
      s.src = '/locales/' + lang + '.js';
      s.onload = function() {
        window._t = function(k) { return (window.I18N && window.I18N[k]) || k; };
        window._i18nReady = true;
        document.dispatchEvent(new Event('i18nready'));
      };
      document.head.appendChild(s);
    })();
  </script>
</head>
<body>
  <div class="page-wrap">
    <div class="sidebar">
      <div id="sidebar-add" class="sidebar-icon" onclick="openCreateModal()" title="" data-i18n-title="nav.new_task">
        <i class="fa-solid fa-plus"></i>
      </div>
      <div id="sidebar-back" class="sidebar-icon" style="display:none" onclick="backToList()" title="" data-i18n-title="nav.back">
        <i class="fa-solid fa-arrow-left"></i>
      </div>
      <div class="sidebar-spacer"></div>
      <div class="sidebar-icon" onclick="toggleLangPicker(event)" id="lang-switch" data-i18n-title="nav.switch_lang">
        <i class="fa-solid fa-globe"></i>
      </div>
      <div class="sidebar-icon" onclick="openLogs()" title="" data-i18n-title="nav.logs">
        <i class="fa-solid fa-scroll"></i>
      </div>
      <div class="sidebar-icon" onclick="openAbout()" title="" data-i18n-title="nav.about">
        <i class="fa-solid fa-circle-info"></i>
      </div>
    </div>
      <div class="lang-picker" id="lang-picker" style="display:none;">
        <div class="lang-picker-item" data-lang="zh-CN" onclick="pickLang('zh-CN')">简体中文</div>
        <div class="lang-picker-item" data-lang="zh-TW" onclick="pickLang('zh-TW')">繁體中文</div>
        <div class="lang-picker-item" data-lang="en" onclick="pickLang('en')">English</div>
      </div>
    <div class="main-content">
      <div class="top-bar">
        <div style="display:flex;align-items:center;gap:10px;">
          <img src="/icon.png" style="width:28px;height:28px;" alt="Fav Vault">
        </div>
        <div></div>
      </div>
      <div class="container" style="position:relative">
        <i id="detail-bg-icon" class="task-card-icon" style="position:absolute;right:0;bottom:0;font-size:800px;opacity:0.06;pointer-events:none;z-index:0;"></i>
        <div id="task-list-view">
          <div id="task-list" class="task-list">
            <% if (tasks.length === 0) { %>
            <div class="empty-state">
              <div style="font-size:48px;opacity:0.3;">+</div>
              <p data-i18n="empty.no_tasks"></p>
            </div>
            <% } else { %>
              <% tasks.forEach(function(t) { %>
                <%- include('partials/task-card', { t: t, sites: sites }) %>
              <% }); %>
            <% } %>
          </div>
        </div>
        <div id="detail-view">
          <div class="detail-layout">
            <div class="detail-left">
              <h2 id="detail-name"></h2>
              <div class="detail-meta" id="detail-meta"></div>
              <div class="detail-actions" id="detail-actions"></div>
            </div>
            <div class="detail-right">
              <div class="downloads-header">
                <h3 data-i18n="detail.downloads"></h3>
                <button id="detail-clear-btn" class="btn btn-ghost btn-sm" style="display:none" onclick="clearDetailDownloads()" data-i18n="detail.clear"></button>
              </div>
              <div id="download-list" class="download-list">
                <div id="detail-load-more" class="load-more" style="display:none">
                  <button class="btn btn-ghost btn-sm" onclick="loadMoreDownloads()" data-i18n="detail.load_more"></button>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div id="about-view" style="display:none;flex:1;overflow-y:auto;">
          <div class="about-wrap">
            <img src="/icon.png" style="width:64px;" alt="Fav Vault">
            <h1>Fav Vault</h1>
            <p class="about-p" data-i18n="about.tagline"></p>
            <p class="about-meta" id="about-version">v<%= localVersion %></p>
            <a class="about-link" href="https://github.com/TanMusong/fav-vault" target="_blank">
              <i class="fa-brands fa-github"></i> Fav Vault on GitHub
            </a>
            <hr>
            <div style="max-width:600px;width:100%;text-align:left;">
              <h2 data-i18n="about.tutorial"></h2>
              <ol class="about-list">
                <li data-i18n="about.step1"></li>
                <li data-i18n="about.step2"></li>
                <li><span data-i18n="about.step3"></span><br><span class="about-hint"><span data-i18n="about.step3_hint"></span></span></li>
                <li data-i18n="about.step4"></li>
                <li data-i18n="about.step5"></li>
                <li data-i18n="about.step6"></li>
              </ol>
            </div>
            <hr>
            <p class="about-p" data-i18n="about.donate"></p>
            <div style="display:flex;gap:12px;justify-content:center;margin-top:8px;">
              <a href="https://www.afdian.com/a/tanmusong" target="_blank"><img src="/afdian.png" height="40"></a>
              <a href="https://ko-fi.com/tanmusong" target="_blank"><img src="/ko-fi.png" height="40"></a>
            </div>
          </div>
        </div>
        <div id="logs-view" style="display:none;flex-direction:column;height:100%;overflow:hidden;">
          <div class="logs-toolbar">
            <button class="btn btn-ghost btn-sm logs-filter active" data-level="all" onclick="filterLogs('all')">All</button>
            <button class="btn btn-ghost btn-sm logs-filter" data-level="error" onclick="filterLogs('error')">Error</button>
            <button class="btn btn-ghost btn-sm logs-filter" data-level="warn" onclick="filterLogs('warn')">Warn</button>
            <button class="btn btn-ghost btn-sm logs-filter" data-level="info" onclick="filterLogs('info')">Info</button>
            <div style="flex:1"></div>
            <button class="btn btn-ghost btn-sm" onclick="clearLogs()" style="color:#f44"><i class="fa-solid fa-trash"></i></button>
          </div>
          <div id="logs-list" style="flex:1;overflow-y:auto;padding:0;position:relative;"></div>
          <div id="logs-top-btn" style="display:none;position:absolute;bottom:20px;right:20px;width:36px;height:36px;border-radius:50%;background:#1d9bf0;color:#fff;border:none;cursor:pointer;font-size:16px;align-items:center;justify-content:center;box-shadow:0 2px 8px rgba(0,0,0,0.4);z-index:10;"><i class="fa-solid fa-arrow-up"></i></div>
        </div>
      </div>

      <div class="modal-overlay" id="modal-overlay" onclick="if(event.target===this)closeModal()">
        <div class="modal">
          <div class="modal-header">
            <h2 id="modal-title" data-i18n="modal.new_task"></h2>
            <button class="modal-close" onclick="closeModal()">&times;</button>
          </div>
          <div class="modal-body">
            <div class="field">
              <label data-i18n="modal.site"></label>
              <div class="site-select" id="f-sites">
                <% sites.forEach(function(s) { %>
                  <div class="site-option" data-site="<%= s.name %>" onclick="selectSite('<%= s.name %>')">
                    <i class="<%= s.icon %> site-option-icon" style="font-size:24px;color:<%= s.color %>"></i>
                    <div class="site-option-label" style="color:<%= s.color %>" data-i18n="site.<%= s.name %>"></div>
                  </div>
                <% }); %>
              </div>
              <div id="site-disabled-hint" style="display:none;color:#ff9800;font-size:13px;margin-top:10px;" data-i18n="modal.site_unsupported"></div>
            </div>
            <div class="field">
              <label data-i18n="modal.interval"></label>
              <input id="f-interval" type="number" value="30" min="10" oninput="checkInterval()">
              <div class="field-hint" id="interval-hint" data-i18n="modal.interval_hint"></div>
            </div>
            <div class="field">
              <label>Cookie</label>
              <textarea id="f-cookie" rows="4" placeholder="" data-i18n-placeholder="modal.cookie_placeholder" style="width:100%;padding:8px 12px;background:#0f0f0f;border:1px solid #333;border-radius:8px;color:#fff;font-size:12px;font-family:monospace;resize:vertical;outline:none;"></textarea>
            </div>
            <div class="advanced-toggle" onclick="toggleAdvanced()">
              <i class="fa-solid fa-gear"></i>
              <span data-i18n="modal.advanced"></span>
              <i class="fa-solid fa-chevron-down advanced-arrow" id="advanced-arrow"></i>
            </div>
            <div id="advanced-settings" style="display:none;">
              <div class="field">
                <label data-i18n="modal.download_path"></label>
                <input id="f-download-path" type="text" value="{type}/{user}/{author_id}_{author}">
                <div style="font-size:11px;color:#666;margin-top:4px;line-height:1.6;">
                  <span data-i18n="modal.path_vars"></span>
                </div>
              </div>
              <div class="field">
                <label data-i18n="modal.max_concurrent"></label>
                <input id="f-max-concurrent" type="number" value="3" min="1" max="10">
              </div>
              <div class="field">
                <label data-i18n="modal.timeout"></label>
                <input id="f-timeout" type="number" value="60" min="10" max="600">
                <div style="font-size:11px;color:#666;margin-top:2px;"><span data-i18n="modal.timeout_hint"></span></div>
              </div>
              <div class="field">
                <label data-i18n="modal.max_retries"></label>
                <input id="f-max-retries" type="number" value="3" min="0" max="10">
              </div>
              <div class="field">
                <label data-i18n="modal.proxy"></label>
                <div style="display:flex;gap:8px;align-items:center;">
                  <label class="switch">
                    <input type="checkbox" id="f-proxy-enabled" onchange="toggleProxyFields()">
                    <span class="slider"></span>
                  </label>
                </div>
              </div>
              <div id="proxy-fields" style="display:none;">
                <div class="field">
                  <label data-i18n="modal.proxy_type"></label>
                  <select id="f-proxy-type">
                    <option value="http">HTTP</option>
                    <option value="socks5">SOCKS5</option>
                  </select>
                </div>
                <div class="field">
                  <label data-i18n="modal.proxy_host"></label>
                  <input id="f-proxy-host" type="text" placeholder="127.0.0.1">
                </div>
                <div class="field">
                  <label data-i18n="modal.proxy_port"></label>
                  <input id="f-proxy-port" type="number" placeholder="1080">
                </div>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button class="btn btn-ghost" onclick="closeModal()" data-i18n="modal.cancel"></button>
            <button class="btn btn-primary" onclick="submitTask()" data-i18n="modal.create"></button>
          </div>
        </div>
      </div>

      <div class="alert-overlay" id="alert-overlay" onclick="closeAlert()">
        <div class="alert-box">
          <div class="alert-msg" id="alert-msg"></div>
          <button class="alert-btn" onclick="closeAlert()" data-i18n="modal.confirm"></button>
        </div>
      </div>

      <div class="alert-overlay" id="confirm-overlay" onclick="confirmCancel()">
        <div class="alert-box" onclick="event.stopPropagation()">
          <div class="alert-msg" id="confirm-msg"></div>
          <div style="display:flex;gap:8px;justify-content:center;">
            <button class="btn btn-ghost" onclick="confirmCancel()" data-i18n="modal.cancel"></button>
            <button class="alert-btn" onclick="confirmOk()" data-i18n="modal.confirm">OK</button>
          </div>
        </div>
      </div>

      <div class="preview-overlay" id="preview-overlay" onclick="closePreview()">
        <span class="preview-close" onclick="closePreview()">&times;</span>
        <span class="preview-nav preview-nav-left" onclick="event.stopPropagation();previewPrev()">&#8249;</span>
        <div id="preview-content" onclick="event.stopPropagation()"></div>
        <span class="preview-nav preview-nav-right" onclick="event.stopPropagation();previewNext()">&#8250;</span>
        <div class="preview-filename" id="preview-filename"></div>
      </div>

    </div>
  </div>

  <script>
    (function() {
      if (location.hash.startsWith('#detail-')) {
        document.getElementById('task-list-view').style.display = 'none';
        document.getElementById('detail-view').style.display = 'flex';
        document.getElementById('sidebar-add').style.display = 'none';
        document.getElementById('sidebar-back').style.display = 'flex';
      } else if (location.hash === '#about') {
        document.getElementById('task-list-view').style.display = 'none';
        document.getElementById('about-view').style.display = 'flex';
        document.getElementById('sidebar-add').style.display = 'none';
        document.getElementById('sidebar-back').style.display = 'flex';
      } else if (location.hash === '#logs') {
        document.getElementById('task-list-view').style.display = 'none';
        document.getElementById('logs-view').style.display = 'flex';
        document.getElementById('sidebar-add').style.display = 'none';
        document.getElementById('sidebar-back').style.display = 'flex';
        setTimeout(function() { openLogs(); }, 0);
      }
    })();
  </script>

  <script>
    const SITES = <%- JSON.stringify(sites) %>;
    let TASKS = <%- JSON.stringify(tasks) %>;
    let eventSource = null;

    function escapeHtml(value) {
      return String(value == null ? '' : value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function jsString(value) {
      return String(value == null ? '' : value).replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/</g, '\\u003c');
    }

    function safeClass(value) {
      return String(value == null ? '' : value).replace(/[^a-zA-Z0-9_-]/g, '');
    }

    function renderTaskCard(t) {
      var site = SITES.find(function(s) { return s.name === t.site; });
      var color = escapeHtml(site ? site.color : '#888');
      var icon = escapeHtml(site ? site.icon : '');
      var siteLabel = site ? escapeHtml(_t('site.' + site.name)) : '';
      var dotClass = t.paused ? 'status-dot-red' : 'status-dot-green';
      var countdown = '';
      var countdownColor = t.last_state === 0 ? '#f44336' : '#1d9bf0';
      if (!t.paused && t.nextRun) {
        countdown = '<div class="countdown" data-next="' + escapeHtml(t.nextRun) + '" data-task-id="' + escapeHtml(t.id) + '" style="font-size:13px;color:' + countdownColor + ';">-</div>';
      }
      var siteBadge = siteLabel ? '<span class="task-site" style="background:' + color + '22;color:' + color + ';font-size:11px;padding:2px 8px;border-radius:4px;font-weight:500;">' + siteLabel + '</span>' : '';
      var downloadCount = t.downloadCount ? '<span class="download-count">' + escapeHtml(t.downloadCount) + ' ' + escapeHtml(_t('countdown.works_unit')) + '</span>' : '';
      return '<a class="task-card" href="#" onclick="event.preventDefault();openDetail(\'' + jsString(t.id) + '\')">' +
        '<i class="' + icon + ' task-card-icon"></i>' +
        '<div class="task-header"><div class="task-name">' +
        '<span class="status-dot ' + dotClass + '"></span>' +
        '<span>' + escapeHtml(t.name) + '</span>' + siteBadge +
        '</div>' + countdown + '</div>' +
        '<div class="task-card-actions">' + downloadCount + '</div>' +
        '</a>';
    }

    async function refreshTaskList() {
      var res = await fetch('/api/tasks');
      var newData = await res.json();
      newData.forEach(function(nt) {
        var old = TASKS.find(function(t) { return t.id === nt.id; });
        if (old && old.next_run && nt.next_run && new Date(old.next_run).getTime() > new Date(nt.next_run).getTime()) {
          nt.next_run = old.next_run;
          nt.nextRun = old.nextRun;
        }
      });
      TASKS = newData;
      var list = document.getElementById('task-list');
      if (TASKS.length === 0) {
        list.innerHTML = '<div class="empty-state"><div style="font-size:48px;opacity:0.3;">+</div><p data-i18n="empty.no_tasks"></p></div>';
      } else {
        list.innerHTML = TASKS.map(function(t) { return renderTaskCard(t); }).join('');
      }
    }

    function showMsg(msg) {
      document.getElementById('alert-msg').textContent = msg;
      document.getElementById('alert-overlay').classList.add('active');
    }
    function closeAlert() {
      document.getElementById('alert-overlay').classList.remove('active');
    }

    var _confirmResolve = null;
    function showConfirm(msg) {
      return new Promise(function(resolve) {
        _confirmResolve = resolve;
        document.getElementById('confirm-msg').textContent = msg;
        document.getElementById('confirm-overlay').classList.add('active');
      });
    }
    function confirmOk() {
      document.getElementById('confirm-overlay').classList.remove('active');
      if (_confirmResolve) { _confirmResolve(true); _confirmResolve = null; }
    }
    function confirmCancel() {
      document.getElementById('confirm-overlay').classList.remove('active');
      if (_confirmResolve) { _confirmResolve(false); _confirmResolve = null; }
    }

    function toggleAdvanced() {
      var el = document.getElementById('advanced-settings');
      var arrow = document.getElementById('advanced-arrow');
      var isOpen = el.style.display !== 'none';
      el.style.display = isOpen ? 'none' : 'block';
      arrow.classList.toggle('open', !isOpen);
    }

    function toggleProxyFields() {
      var enabled = document.getElementById('f-proxy-enabled').checked;
      document.getElementById('proxy-fields').style.display = enabled ? '' : 'none';
    }

    function getAdvancedConfig() {
      return {
        downloadPath: document.getElementById('f-download-path').value.trim() || '{type}/{user}/{author_id}_{author}',
        maxConcurrent: parseInt(document.getElementById('f-max-concurrent').value) || 3,
        timeout: parseInt(document.getElementById('f-timeout').value) || 120,
        maxRetries: parseInt(document.getElementById('f-max-retries').value) || 3,
        proxy: {
          enabled: document.getElementById('f-proxy-enabled').checked,
          type: document.getElementById('f-proxy-type').value,
          host: document.getElementById('f-proxy-host').value.trim(),
          port: parseInt(document.getElementById('f-proxy-port').value) || 0
        }
      };
    }

    function setAdvancedConfig(cfg) {
      if (!cfg) cfg = {};
      document.getElementById('f-download-path').value = cfg.downloadPath || '{type}/{user}/{author_id}_{author}';
      document.getElementById('f-max-concurrent').value = cfg.maxConcurrent || 3;
      document.getElementById('f-timeout').value = cfg.timeout || 60;
      document.getElementById('f-max-retries').value = cfg.maxRetries || 3;
      var proxy = cfg.proxy || {};
      document.getElementById('f-proxy-enabled').checked = !!proxy.enabled;
      document.getElementById('f-proxy-type').value = proxy.type || 'http';
      document.getElementById('f-proxy-host').value = proxy.host || '';
      document.getElementById('f-proxy-port').value = proxy.port || '';
      toggleProxyFields();
      document.getElementById('advanced-settings').style.display = 'none';
      document.getElementById('advanced-arrow').classList.remove('open');
    }

    function resetAdvancedConfig() {
      document.getElementById('f-download-path').value = '{type}/{user}/{author_id}_{author}';
      document.getElementById('f-max-concurrent').value = 3;
      document.getElementById('f-timeout').value = 60;
      document.getElementById('f-max-retries').value = 3;
      document.getElementById('f-proxy-enabled').checked = false;
      document.getElementById('f-proxy-type').value = 'http';
      document.getElementById('f-proxy-host').value = '';
      document.getElementById('f-proxy-port').value = '';
      toggleProxyFields();
      document.getElementById('advanced-settings').style.display = 'none';
      document.getElementById('advanced-arrow').classList.remove('open');
    }

    function checkInterval() {
      const v = parseInt(document.getElementById('f-interval').value) || 0;
      document.getElementById('interval-hint').classList.toggle('show', v > 0 && v < 10);
    }

    function selectSite(name) {
      document.querySelectorAll('.site-option').forEach(function(el) {
        const s = SITES.find(function(s) { return s.name === el.dataset.site; });
        const isSelected = el.dataset.site === name;
        const color = s ? s.color : '#1d9bf0';
        el.classList.toggle('selected', isSelected);
        el.style.borderColor = isSelected ? color + '44' : '#333';
        el.style.background = isSelected ? color + '08' : '';
      });
      const site = SITES.find(function(s) { return s.name === name; });
      const enabled = site && site.enabled;
      document.getElementById('f-interval').closest('.field').style.display = enabled ? '' : 'none';
      document.getElementById('f-cookie').closest('.field').style.display = enabled ? '' : 'none';
      document.getElementById('site-disabled-hint').style.display = enabled ? 'none' : '';
      document.querySelector('.modal-footer .btn-primary').disabled = !enabled;
      if (site && site.cookieField) {
        document.getElementById('f-cookie').placeholder = _t(site.cookieField.placeholder);
      }
    }

    function openCreateModal() {
      document.getElementById('modal-title').textContent = _t('modal.new_task');
      document.getElementById('f-interval').value = 30;
      document.getElementById('f-cookie').value = '';
      document.getElementById('interval-hint').classList.remove('show');
      document.getElementById('f-interval').closest('.field').style.display = '';
      document.getElementById('f-cookie').closest('.field').style.display = '';
      document.getElementById('site-disabled-hint').style.display = 'none';
      resetAdvancedConfig();
      var btn = document.querySelector('.modal-footer .btn-primary');
      btn.disabled = false;
      btn.textContent = _t('modal.create');
      btn.onclick = submitTask;
      document.getElementById('modal-overlay').classList.add('active');
      if (SITES.length > 0) selectSite(SITES[0].name);
    }

    function closeModal() {
      document.getElementById('modal-overlay').classList.remove('active');
      document.querySelectorAll('.site-option').forEach(function(el) {
        el.style.pointerEvents = '';
        el.style.opacity = '';
      });
    }

    async function submitTask() {
      const interval = parseInt(document.getElementById('f-interval').value) || 30;
      if (!document.querySelector('.site-option.selected')) return showMsg(_t('msg.select_site'));
      const siteName = document.querySelector('.site-option.selected').dataset.site;
      if (interval < 10) return showMsg(_t('msg.interval_short'));
      const cookies = document.getElementById('f-cookie')?.value?.trim() || '';
      if (!cookies) return showMsg(_t('msg.cookie_required'));

      const btn = document.querySelector('.modal-footer .btn-primary');
      btn.textContent = _t('msg.validating');
      btn.disabled = true;
      document.querySelector('.modal-body').style.pointerEvents = 'none';
      document.querySelector('.modal-body').style.opacity = '0.5';

      const res = await fetch('/api/tasks', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ site: siteName, interval: interval * 60, cookies, customConfigJson: getAdvancedConfig() })
      });
      const data = await res.json();
      btn.textContent = _t('modal.create');
      btn.disabled = false;
      document.querySelector('.modal-body').style.pointerEvents = '';
      document.querySelector('.modal-body').style.opacity = '';

      if (!res.ok) { showMsg(_t('msg.create_failed') + _t(data.error || 'msg.unknown_error')); return; }
      closeModal();
      TASKS.unshift(data);
      var list = document.getElementById('task-list');
      if (list.querySelector('.empty-state')) list.innerHTML = '';
      list.insertAdjacentHTML('afterbegin', renderTaskCard(data));
    }

    async function togglePause(taskId) {
      const res = await fetch('/api/tasks/' + taskId + '/pause', { method: 'POST' });
      const data = await res.json();
      if (data.ok) refreshTaskList();
    }

