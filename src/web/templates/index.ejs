    function connectSSE() {
      if (eventSource) eventSource.close();
      eventSource = new EventSource('/api/events');

      eventSource.addEventListener('task:started', function() { if (!currentTaskId) refreshTaskList(); });
      eventSource.addEventListener('task:completed', function() { if (currentTaskId) { loadDownloads(); refreshDetailTask(); } else refreshTaskList(); });
      eventSource.addEventListener('task:failed', function() { if (currentTaskId) { loadDownloads(); refreshDetailTask(); } else refreshTaskList(); });
      eventSource.addEventListener('task:paused', function() { if (currentTaskId) refreshDetailTask(); else refreshTaskList(); });
      eventSource.addEventListener('scheduler:updated', function(e) {
        const data = JSON.parse(e.data);
        const el = document.querySelector('.countdown[data-task-id="' + data.taskId + '"]');
        if (el) el.dataset.next = data.nextRun;
        if (currentTaskId && data.taskId === currentTaskId && currentTaskData) {
          currentTaskData.next_run = data.nextRun;
          renderDetailMeta();
        }
      });
      eventSource.addEventListener('download:added', function(e) {
        if (currentTaskId) {
          var data = JSON.parse(e.data);
          if (data.taskId !== currentTaskId) return;
          detailOffset = 0;
          loadDownloads();
          refreshDetailTask();
        } else {
          refreshTaskList();
        }
      });
      eventSource.addEventListener('download:progress', function(e) {
        if (!currentTaskId) return;
        var data = JSON.parse(e.data);
        if (data.taskId !== currentTaskId) return;
        var matched = false;
        for (var i = 0; i < detailDownloads.length; i++) {
          if (detailDownloads[i].post_id === data.postId) {
            detailDownloads[i].files = data.files;
            if (data.state) detailDownloads[i].state = data.state;
            updateDownloadProgress(i, data.files);
            if (data.state && data.state !== 3) refreshDetailTask();
            matched = true;
            break;
          }
        }
        if (!matched) {
          console.log('[SSE] download:progress NO MATCH for postId:', data.postId, 'detailDownloads ids:', detailDownloads.map(function(d){return d.post_id}).join(','));
        }
      });

      eventSource.onerror = function() { setTimeout(connectSSE, 3000); };
    }

