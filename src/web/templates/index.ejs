    function renderPostGroup(g, i) {
      var stateMap = { 1: [_t('status.completed'), 'status-success'], 2: [_t('status.failed'), 'status-failed'], 3: [_t('status.downloading'), 'status-downloading'] };
      var isNoMedia = g.state_message === _t('status.no_media');
      var st = isNoMedia ? [_t('status.no_media'), 'status-nomedia'] : (stateMap[g.state] || [_t('status.unknown'), '']);
      var hasFiles = g.files && g.files.length > 0 && !isNoMedia;
      var overallProgress = calcOverallProgress(g);
      var html = '<div class="post-group" id="post-' + i + '"><div class="post-header" onclick="togglePost(' + i + ')">';
      html += '<div class="post-info"><span class="post-username">' + escapeHtml(g.author || _t('detail.unknown_author')) + '</span>';
      html += '<span class="post-text">' + escapeHtml(g.desc || _t('detail.no_desc')) + '</span></div>';
      html += '<div class="post-meta"><span class="post-status ' + safeClass(st[1]) + '">' + escapeHtml(st[0]) + '</span>';
      if (g.state === 3 && overallProgress > 0) {
        html += '<span class="download-progress-text">' + overallProgress + '%</span>';
      }
      if (hasFiles) {
        html += '<span class="post-count">' + g.files.length + ' ' + _t('detail.files') + '</span>';
        html += '<span class="post-arrow' + (g.state === 3 ? ' open' : '') + '" id="arrow-' + i + '">▶</span>';
      }
      html += '</div></div>';
      if (g.state === 3 && hasFiles) {
        var p = calcOverallProgress(g);
        html += '<div class="post-progress-bar"><div class="post-progress-fill" id="progress-bar-' + i + '" style="width:' + p + '%"></div></div>';
      }
      if (hasFiles) {
        html += '<div class="post-files' + (g.state === 3 ? ' open' : '') + '" id="files-' + i + '">';
        g.files.forEach(function(f, fi) {
