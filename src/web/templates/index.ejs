      return totalExpected > 0 ? Math.round(totalDownloaded / totalExpected * 100) : 0;
    }

    function updateDownloadProgress(postIdx, files) {
      var g = detailDownloads[postIdx];
      if (!g) return;
      g.files = files;
      var postEl = document.getElementById('post-' + postIdx);
      if (!postEl) return;
      var statusEl = postEl.querySelector('.post-status');
      if (statusEl) {
        var stateMap = { 1: [_t('status.completed'), 'status-success'], 2: [_t('status.failed'), 'status-failed'], 3: [_t('status.downloading'), 'status-downloading'] };
        var st = stateMap[g.state] || [_t('status.unknown'), ''];
        statusEl.className = 'post-status ' + st[1];
        statusEl.textContent = st[0];
      }
      var p = calcOverallProgress(g);
      var progressText = postEl.querySelector('.download-progress-text');
      if (progressText) progressText.textContent = p + '%';
      var progressBar = document.getElementById('progress-bar-' + postIdx);
